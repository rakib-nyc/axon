    affiliation: Independent Research
repository-code: "https://github.com/rakib-nyc/axon"
license: MIT
keywords:
  - associative memory
  - attractor networks
  - storage capacity
  - sparse coding
  - Metal
  - Apple Silicon
preferred-citation:
  type: article
  title: "Memory capacity as a retrieval limit: direct synaptic measurement across a capacity range in a sparse binary assembly network"
  abstract: >-
    Across a five-fold increase in stored-pattern count the sustained-recall
    ratio falls by 3.7x while within-assembly functional synaptic density
    remains constant, measured directly rather than inferred from behaviour.
  authors:
    - family-names: Islam
      given-names: Muhammad Rakibul
